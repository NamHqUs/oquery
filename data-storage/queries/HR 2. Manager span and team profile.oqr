Employees: Id ManagerId,
    Concat(FirstName, < >, LastName) Manager,
    Department.Name Department,
    CountDistinct(DirectReports.Id) DirectReports,
    CountDistinct(DirectReports.LocationId) TeamLocations,
    ROUND(AVG(DirectReports.Salary), <2>) AverageTeamSalary,
    ROUND(ReviewSummary.AverageTeamRating, <2>) AverageTeamRating,
    ROUND(SUM(DirectReports.Salary), <2>) TeamPayroll
  Where DirectReports.Id IS NOT NULL
  Order DirectReports DESC, TeamPayroll DESC
  Take 10
  Left Join ReviewSummary ReviewSummary On Id = ReviewSummary.ManagerId
ReviewSummary is PerformanceReviews: Employee.ManagerId ManagerId, AVG(Rating) AverageTeamRating
  Where ReviewYear = <2025>
