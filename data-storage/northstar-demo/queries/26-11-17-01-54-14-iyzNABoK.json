        "kind": "field",
        "field": "Category"
      },
      "alias": null
    },
    {
      "field": {
        "kind": "function",
        "function": "Count",
        "arguments": [
          {
            "kind": "field",
            "field": "Id"
          }
        ]
      },
      "alias": "ProductCount"
    },
    {
      "field": {
