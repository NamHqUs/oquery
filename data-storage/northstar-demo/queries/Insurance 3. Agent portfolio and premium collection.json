{
  "domainId": "INSURANCE_DOMAIN",
  "name": "I3. Agent portfolio and premium collection",
  "rawText": "# Do you know which insurance agents generate the most premium revenue and how effectively they manage their policy portfolios and payment collections?\n#  - Which insurance agents generate the highest paid premium revenue?\n#  - Who has sold the most insurance policies?\n#  - Which agents manage the largest number of active policies?\n#  - Which agents have the highest number of late premium payments?\n#  - Which agents have the most missed premium payments?\n#  - Are agents with the highest premium revenue also managing the largest policy portfolios?\n#  - Which agents have strong premium collections but relatively few late or missed payments?\n#  - How does payment collection performance vary across insurance agency locations?\n#  - Which agents may need attention due to high numbers of late or missed payments?\n#  - Who are our top-performing insurance agents based on premium revenue and policy activity?\n# __________________________________________________\n\nAgents: Id AgentId,\n    Concat(FirstName, \u003C \u003E, LastName) Agent,\n    Location.City OfficeCity,\n    Policies.Count() PoliciesSold,\n    Policies.CountIf(Status = \u003CActive\u003E) ActivePolicies,\n    Round(IfNull(Policies.Sum(PremiumPayments.SumIf(Amount, Status = \u003CPaid\u003E)), 0), 2) PaidPremiums,\n    IfNull(Policies.Sum(PremiumPayments.CountIf(Status = \u003CLate\u003E)), 0) LatePayments,\n    IfNull(Policies.Sum(PremiumPayments.CountIf(Status = \u003CMissed\u003E)), 0) MissedPayments\n  Where Department.Name = \u003CInsurance Agency\u003E\n  Order PaidPremiums DESC\n  Take 10",
  "id": "Insurance 3. Agent portfolio and premium collection",
  "isBuiltin": false,
  "contexts": {},
